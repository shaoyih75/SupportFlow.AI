# Copy to backend/.env (never commit .env)
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow
TEST_DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow_test

# Signs access tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Class 6 opening demo: set to 1 to mount the deliberately insecure IDOR endpoint
ENABLE_IDOR_DEMO=0

# S3 file storage. Defaults match the local S3 in docker compose (any key works locally).
# Real AWS: S3_ENDPOINT_URL= (empty), remove the two keys, and use AWS_PROFILE instead.
S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=supportflow-documents
TEST_S3_BUCKET=supportflow-documents-test
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
