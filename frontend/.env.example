# Server side: where Next.js proxies /api/* (default http://localhost:8000)
BACKEND_URL=http://localhost:8000

# Browser side: base URL for API calls (default /api, which goes through the proxy).
# Set to http://localhost:8000/api to skip the proxy and call FastAPI directly (uses CORS).
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
